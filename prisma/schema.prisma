generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Hospital {
  id          String       @id @default(uuid())
  name        String
  type        String?
  region      String?
  status      String       @default("ACTIVE")
  users       User[]
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  name       String
  users      User[]
}

model User {
  id            String             @id @default(uuid())
  email         String?            @unique
  doctorLicense String?            @unique
  passwordHash  String
  name          String
  specialty     String?
  phone         String?
  telephone     String?
  birthDate     String?
  address       String?
  jobTitle      String?
  hospitalName  String?
  institutionNumber String?
  role          String             @default("DOCTOR")
  points        Int                @default(0)
  title         String?
  status        String             @default("PENDING")
  licenseVerifiedAt DateTime?
  termsAgreedAt DateTime?
  privacyAgreedAt DateTime?
  patientInfoAgreedAt DateTime?
  qualityImprovementAgreedAt DateTime?
  marketingAgreedAt DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  hospitalId    String?
  hospital      Hospital?          @relation(fields: [hospitalId], references: [id])
  hospitalDirectoryId String?
  hospitalDirectory   HospitalDirectory? @relation(fields: [hospitalDirectoryId], references: [id])
  departmentId  String?
  department    Department?        @relation(fields: [departmentId], references: [id])
  conversations Conversation[]
  feedbacks     Feedback[]
  documents     UploadedDocument[]
  bookmarks     Bookmark[]
  reviews       ReviewWorkflow[]   @relation("Reviewer")
  preferences   UserPreference[]
  trainingExamples AiTrainingExample[]
  recruitProfile RecruitProfile?
  recruitPostings RecruitPosting[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([doctorLicense])
  @@index([status])
  @@index([hospitalDirectoryId])
}

model VerifiedDoctorLicense {
  id            String    @id @default(uuid())
  licenseNumber String    @unique
  doctorName    String?
  specialty     String?
  status        String    @default("ACTIVE")
  source        String    @default("MANUAL_ALLOWLIST")
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([licenseNumber])
  @@index([status])
}

model RecruitProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  mode            String   @default("SEEKING")
  locationAddress String?
  latitude        Float?
  longitude       Float?
  specialty       String?
  workTypes       String?
  workMethods     String?
  workHours       String?
  minPay          Int?
  maxPay          Int?
  priority        String   @default("BALANCED")
  availableFrom   String?
  intro           String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([mode])
  @@index([specialty])
}

model RecruitPosting {
  id              String   @id @default(uuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id])
  hospitalDirectoryId String?
  hospitalDirectory   HospitalDirectory? @relation(fields: [hospitalDirectoryId], references: [id])
  hospitalName    String
  title           String
  specialty       String?
  locationAddress String
  latitude        Float?
  longitude       Float?
  workTypes       String?
  workMethods     String?
  workHours       String?
  payMin          Int?
  payMax          Int?
  priority        String   @default("BALANCED")
  description     String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([specialty])
  @@index([hospitalDirectoryId])
}

model HospitalDirectory {
  id              String   @id @default(uuid())
  encryptedCode   String   @unique
  name            String
  typeCode        String?
  typeName        String?
  sidoCode        String?
  sidoName        String?
  sigunguCode     String?
  sigunguName     String?
  eupmyeondong    String?
  zipCode         String?
  address         String?
  phone           String?
  homepage        String?
  openDate        String?
  totalDoctors    Int?
  generalDoctors  Int?
  specialists     Int?
  dentistDoctors  Int?
  koreanDoctors   Int?
  midwives        Int?
  longitude       Float?
  latitude        Float?
  landmark        String?
  direction       String?
  distance        String?
  parkingCapacity Int?
  parkingPaid     String?
  parkingNote     String?
  closedSunday    String?
  closedHoliday   String?
  erDayAvailable  String?
  erDayPhone1     String?
  erDayPhone2     String?
  erNightAvailable String?
  erNightPhone1   String?
  erNightPhone2   String?
  lunchWeekday    String?
  lunchSaturday   String?
  receptionWeekday String?
  receptionSaturday String?
  sundayStart     Int?
  sundayEnd       Int?
  mondayStart     Int?
  mondayEnd       Int?
  tuesdayStart    Int?
  tuesdayEnd      Int?
  wednesdayStart  Int?
  wednesdayEnd    Int?
  thursdayStart   Int?
  thursdayEnd     Int?
  fridayStart     Int?
  fridayEnd       Int?
  saturdayStart   Int?
  saturdayEnd     Int?
  rawBasic        Json?
  rawDetail       Json?
  users           User[]
  recruitPostings RecruitPosting[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([sidoName])
  @@index([sigunguName])
  @@index([typeName])
  @@index([address])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([key])
}

model AiTrainingExample {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  sessionId    String?
  source       String   @default("CHAT_FEEDBACK")
  rating       String
  prompt       String
  response     String
  responseJson Json?
  history      Json?
  comment      String?
  status       String   @default("RAW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([rating])
  @@index([status])
  @@index([createdAt])
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  category  String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id              String            @id @default(uuid())
  conversationId  String
  conversation    Conversation      @relation(fields: [conversationId], references: [id])
  role            String
  content         String
  messageType     String?
  parentMessageId String?
  parentMessage   Message?          @relation("MessageHistory", fields: [parentMessageId], references: [id])
  childMessages   Message[]         @relation("MessageHistory")
  sources         SourceReference[]
  feedbacks       Feedback[]
  bookmarks       Bookmark[]
  tags            MessageTag[]
  reviewWorkflow  ReviewWorkflow?
  insightSummary  InsightSummary?
  createdAt       DateTime          @default(now())
}

model SourceReference {
  id            String   @id @default(uuid())
  messageId     String
  message       Message  @relation(fields: [messageId], references: [id])
  sourceType    String
  sourceTitle   String
  sourceUrlOrId String?
  snippet       String?
  rank          Int?
  createdAt     DateTime @default(now())
}

model Feedback {
  id           String   @id @default(uuid())
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  feedbackType String
  comment      String?
  createdAt    DateTime @default(now())
}

model InsightSummary {
  id                 String   @id @default(uuid())
  messageId          String   @unique
  message            Message  @relation(fields: [messageId], references: [id])
  summaryText        String
  consensusPoints    String
  disagreementPoints String
  pendingChecks      String
  updatedAt          DateTime @updatedAt
}

model UploadedDocument {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  fileName    String
  fileType    String?
  storagePath String
  parsedText  String?
  status      String   @default("UPLOADING")
  createdAt   DateTime @default(now())
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
}

model MessageTag {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  tag       String
  createdAt DateTime @default(now())

  @@unique([messageId, tag])
}

model ReviewWorkflow {
  id          String   @id @default(uuid())
  messageId   String   @unique
  message     Message  @relation(fields: [messageId], references: [id])
  reviewerId  String?
  reviewer    User?    @relation("Reviewer", fields: [reviewerId], references: [id])
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  version     String   @default("v1.0")
  reviewNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PatientIntake {
  id          String   @id @default(uuid())
  patientLang String
  symptom     String
  duration    String
  history     String
  occupation  String?
  summaryChat String?
  createdAt   DateTime @default(now())
}

model ChartRecord {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
}

model PatientSummary {
  id        String   @id @default(uuid())
  lang      String
  content   String
  createdAt DateTime @default(now())
}

model ConsentForm {
  id        String   @id @default(uuid())
  lang      String
  signature String
  content   String?
  createdAt DateTime @default(now())
}

model Drug {
  id             String   @id @default(uuid())
  productName    String
  ingredientName String?
  company        String?
  standardCode   String?  @unique
  insuranceCode  String?
  atcCode        String?
  priceLabel     String?
  reimbursement  String?
  type           String?
  releaseDate    String?
  imageUrl       String?
  imageSource    String?
  imageStatus    String?
  imageCheckedAt DateTime?
  usageFrequency Int      @default(0)
  rawJson        String?
  durInfo        String? // 병용금기, 임부/연령 금기 주의사항 (JSON 배열 or 텍스트)
  efficacy       String? // 의약품 효능 및 적응증 (식약처 허가정보 표기)
  precaution     String? // 사용상의 주의사항 및 투여기간 등
  identification String? // 낱알 식별 정보 (모양, 색상, 마크 등)
  publicApiDump  String? // 1~10번 12개 API 전체(DUR, 비급여, 허가, 식별 등) 원천 데이터(Raw XML/JSON) 100% 무손실 통합 보관용 필드
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productName])
  @@index([ingredientName])
  @@index([company])
  @@index([insuranceCode])
  @@index([atcCode])
  @@index([imageStatus])
  @@index([usageFrequency])
}
